    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "rot-js": "^2.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^39.0.0",
    "vite": "^8.3.3",
    "vitest": "^4.0.0"
  }
}
