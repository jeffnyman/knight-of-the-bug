{
  "name": "@jeffnyman/knight-of-the-bug",
  "version": "0.2.0",
  "description": "A Pedagogical Exploration into Bug Hunting",
  "author": "Jeff Nyman",
  "license": "MIT",
  "type": "module",
  "private": true,
  "keywords": [
    "testing",
    "exploration",
    "roguelike",
    "game"
  ],
  "scripts": {
    "dev": "vite --host --open",
    "build": "vite build",
