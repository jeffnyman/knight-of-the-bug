{
  "name": "@jeffnyman/knight-of-the-bug",
  "version": "0.2.0",
  "description": "A Pedagogical Exploration into Bug Hunting",
  "author": "Jeff Nyman",
  "license": "MIT",
  "type": "module",
  "private": true,
  "keywords": [
    "testing",
    "exploration",
    "roguelike",
    "game"
  ],
  "scripts": {
    "dev": "vite --host --open",
    "build": "vite build",
    "preview": "vite preview --host --open",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --omit=dev",
    "audit:all": "npm audit"
  },
  "dependencies": {
    "rot-js": "^2.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.3.3",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "fsevents": false
  }
}
